{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?\\nARG \\S+_VERSION=(?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["kubernetes/kubernetes", "siderolabs/talos"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchDatasources": ["deb"],
      "matchPackageNames": ["claude-code"],
      "schedule": ["* * * * 1"]
    }
  ]
}
