#!/bin/bash
# claude-rc <dir under ~/projects> <spawn mode>
set -uo pipefail
name=$1 mode=$2
dir=$HOME/projects/$name

for i in $(seq 1 120); do
  missing=()
  [ -f "$HOME/.claude-rc-ready" ] || missing+=("$HOME/.claude-rc-ready")
  [ -d "$dir" ] || missing+=("directory $dir")
  claude auth status 2>/dev/null | jq -e .loggedIn >/dev/null || missing+=("claude login")
  [ ${#missing[@]} -eq 0 ] && break
  echo "claude-rc[$name]: waiting for ${missing[*]} ($i/120)"
  [ "$i" -eq 120 ] && { echo "claude-rc[$name]: gave up after an hour"; exit 1; }
  sleep 30
done

cd "$dir" || exit 1
echo "claude-rc[$name]: starting $(claude --version) in $dir, spawn mode $mode"
claude remote-control --spawn "$mode" --permission-mode auto
rc=$?
echo "claude-rc[$name]: server exited with status $rc"
exit "$rc"
