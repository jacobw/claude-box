{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "The tool versions pinned by ARG lines in the Dockerfile.",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\S+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": [
        "kubectl stays within one minor of the cluster it talks to, so only",
        "its patches are proposed. Move to the next minor by hand when the",
        "cluster moves."
      ],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
