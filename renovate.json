{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?\\nARG \\S+_VERSION=(?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "description": [
        "Auto-merge minor and patch updates once the image build passes.",
        "platformAutomerge is off because repo-level 'Allow auto-merge' is",
        "disabled on GitHub, so Renovate merges the PR itself. Majors wait for a person."
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": ["kubectl follows the cluster's minor: bump it by hand when the cluster moves."],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "matchDatasources": ["deb"],
      "matchPackageNames": ["claude-code"],
      "schedule": ["* * * * 1"]
    }
  ]
}
